# Copy to mobile/.env and adjust. mobile/.env is gitignored.
# EXPO_PUBLIC_* vars are inlined into the client bundle (not secret).
# Changing this requires restarting Metro with a cache clear: `npx expo start -c`.
#
# On a real phone (Expo Go), localhost points at the phone itself — use the
# laptop's LAN IP so the device can reach the backend, e.g. http://192.168.1.5:8000
# Find it with `hostname -I` (Linux) / `ipconfig getifaddr en0` (macOS).

EXPO_PUBLIC_API_URL=http://localhost:8000
