# Copy to backend/.env and adjust. backend/.env is gitignored.
# Local dev uses the machine's PostgreSQL 18 (not Docker), on port 5432.
# Driver is psycopg3 — note the "+psycopg" in the URL.
# Role name avoids the reserved "pg_" prefix, hence "pgrent" not "pg_rent".

DATABASE_URL=postgresql+psycopg://pgrent:pgrent@localhost:5432/pgrent_dev
TEST_DATABASE_URL=postgresql+psycopg://pgrent:pgrent@localhost:5432/pgrent_test

# Must be at least 32 bytes for HS256 (RFC 7518 3.2); PyJWT warns if it is shorter.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-use-a-32-byte-random-secret
# Optional; the defaults below are what the app uses when these are unset.
# JWT_ALGORITHM=HS256
# JWT_EXPIRES_MINUTES=43200   # 30 days

TZ=Asia/Kolkata

# Comma-separated browser origins allowed to call the API. Needed only for the
# Expo *web* target; a real phone does not enforce origins. Never use "*".
# CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
