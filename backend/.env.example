# Copy to backend/.env and adjust. backend/.env is gitignored.
# Local dev uses the machine's PostgreSQL 18 (not Docker), on port 5432.
# Driver is psycopg3 — note the "+psycopg" in the URL.
# Role name avoids the reserved "pg_" prefix, hence "pgrent" not "pg_rent".

DATABASE_URL=postgresql+psycopg://pgrent:pgrent@localhost:5432/pgrent_dev
TEST_DATABASE_URL=postgresql+psycopg://pgrent:pgrent@localhost:5432/pgrent_test

JWT_SECRET=change-me-in-production

TZ=Asia/Kolkata
